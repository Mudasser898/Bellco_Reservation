# --- Sanity ---------------------------------------------------------------
# Identifiant du projet Sanity (Studio > Settings, ou `npx sanity init`).
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Jeton de lecture, uniquement si le dataset est privé. Jamais préfixé PUBLIC_.
SANITY_READ_TOKEN=

# --- Formulaire de devis --------------------------------------------------
# Clé API Resend (https://resend.com) pour l'envoi des demandes de devis.
RESEND_API_KEY=
# Adresse expéditrice vérifiée chez Resend.
DEVIS_FROM_EMAIL=devis@bellcorenovation.com
# Destinataire des demandes.
DEVIS_TO_EMAIL=contact@bellcorenovation.com

# --- Cloudflare Turnstile -------------------------------------------------
# Clé publique, injectée dans le formulaire.
PUBLIC_TURNSTILE_SITE_KEY=
# Clé privée, utilisée côté serveur pour la vérification.
TURNSTILE_SECRET_KEY=
