---
/**
 * Barre d'action fixe en bas d'écran, mobile uniquement.
 *
 * Trois gestes, toujours accessibles : appeler, écrire sur WhatsApp, demander
 * un devis. Aucun JavaScript — ce sont trois liens.
 */
import { ENTREPRISE, lienWhatsApp } from '~/lib/site';
import type { Reglages } from '~/lib/sanity/types';

interface Props {
  readonly reglages?: Reglages;
  /** Contexte français injecté dans le message WhatsApp pré-rempli. */
  readonly contexteWhatsApp?: string | undefined;
}
const { reglages = {}, contexteWhatsApp } = Astro.props;
const telLien = reglages.telephoneInternational ?? ENTREPRISE.telephoneE164;
---

<div class="barre-mobile">
  <a href={`tel:${telLien}`} class="barre-action">
    <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M4.5 3h3l1.5 3.5-2 1.5a10 10 0 0 0 5 5l1.5-2L17 12.5v3a1.5 1.5 0 0 1-1.6 1.5A13.5 13.5 0 0 1 3 4.6 1.5 1.5 0 0 1 4.5 3Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
    </svg>
    Appeler
  </a>

  <a href={lienWhatsApp(contexteWhatsApp)} class="barre-action barre-action--milieu" rel="noopener">
    <svg class="size-5" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <path
        d="M10 2.5a7.5 7.5 0 0 0-6.4 11.4L2.5 17.5l3.7-1.1A7.5 7.5 0 1 0 10 2.5Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linejoin="round"></path>
    </svg>
    WhatsApp
  </a>

  <a href="/devis/" class="barre-devis">Demander un devis</a>
</div>

<style>
  .barre-mobile {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: var(--z-bar);
    display: grid;
    grid-template-columns: 1fr 1fr 1.4fr;
    background-color: var(--color-paper);
    border-top: 1px solid var(--color-line);
    box-shadow: var(--shadow-bar-up);
    /* Laisse passer la barre de navigation iOS. */
    padding-bottom: env(safe-area-inset-bottom);
  }

  .barre-action,
  .barre-devis {
    display: flex;
    align-items: center;
    justify-content: center;
    /* 60 px : au-delà de la cible tactile minimale de 44 px (WCAG 2.5.5). */
    min-height: 60px;
    font-size: var(--text-caption);
    font-weight: 600;
  }

  .barre-action {
    flex-direction: column;
    gap: calc(var(--spacing) * 1);
    color: var(--color-ink-900);
  }
  .barre-action--milieu {
    border-inline: 1px solid var(--color-line);
  }

  .barre-devis {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-small);
  }
  .barre-devis:hover {
    background-color: var(--color-accent-hover);
  }

  /* Masquage au-delà de lg. Placé en fin de feuille à dessein : `lg:hidden`
     perdrait face au sélecteur scopé d Astro, et un @media de même
     spécificité placé avant la règle de base serait écrasé par elle. */
  @media (width >= 1120px) {
    .barre-mobile {
      display: none;
    }
  }
</style>
