---
/**
 * Page 404.
 *
 * Plutôt qu'un cul-de-sac, elle propose les chemins réellement utiles : les
 * prestations, les réalisations et le contact. L'ancien site renvoyait vers
 * des pages qui n'existent plus, dont plusieurs pages de spam.
 */
import Page from '~/layouts/Page.astro';
import { SERVICES } from '~/lib/site';
---

<Page
  titre="Page introuvable"
  description="Cette page n’existe pas ou a été déplacée. Retrouvez nos prestations de rénovation, nos réalisations et nos coordonnées."
  noindex={true}
>
  <section class="pt-header">
    <div class="wrap section-y">
      <p class="text-overline text-accent uppercase">Erreur 404</p>
      <h1 class="font-display text-h1 mt-3 max-w-measure">Cette page n’existe pas.</h1>
      <p class="text-ink-700 mt-6 max-w-measure text-lead">
        Le lien que vous avez suivi est peut-être ancien, ou l’adresse comporte une
        faute de frappe. Voici par où reprendre.
      </p>

      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="/"
          class="bg-primary text-on-primary hover:bg-accent rounded px-6 py-4 text-body-sm font-semibold"
        >
          Retour à l’accueil
        </a>
        <a
          href="/contact/"
          class="border-line-strong hover:border-primary rounded border px-6 py-4 text-body-sm font-semibold"
        >
          Nous contacter
        </a>
      </div>

      <h2 class="font-display text-h3 mt-16">Nos prestations</h2>
      <ul class="mt-6 grid gap-x-8 gap-y-3 md:grid-cols-2 lg:grid-cols-3">
        {
          SERVICES.map((service) => (
            <li>
              <a href={`/services/${service.slug}/`} class="link-rule text-body-sm">
                {service.titre}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Page>
