---
/**
 * Mentions légales — obligatoires (LCEN, article 6 III).
 *
 * Les valeurs viennent des réglages Sanity. Tant qu'un champ n'est pas
 * renseigné, un marqueur voyant le signale plutôt qu'un vide silencieux :
 * une mention incomplète expose l'entreprise.
 */
import Page from '~/layouts/Page.astro';
import Breadcrumbs from '~/components/chrome/Breadcrumbs.astro';
import TexteLegal from '~/components/blocks/TexteLegal.astro';
import ACompleter from '~/components/blocks/ACompleter.astro';
import { reglages as chargerReglages } from '~/lib/sanity/queries';
import { ENTREPRISE } from '~/lib/site';

const r = await chargerReglages();
const filAriane = [{ libelle: 'Mentions légales', href: '/mentions-legales/' }];

const nom = r.nomEntreprise ?? ENTREPRISE.nom;
const rue = r.adresseRue ?? ENTREPRISE.adresse.rue;
const codePostal = r.adresseCodePostal ?? ENTREPRISE.adresse.codePostal;
const ville = r.adresseVille ?? ENTREPRISE.adresse.ville;
const telephone = r.telephone ?? ENTREPRISE.telephoneAffiche;
const email = r.email ?? ENTREPRISE.email;
---

<Page
  titre="Mentions légales"
  description="Mentions légales du site de Bellco Rénovation : éditeur, hébergeur, assurance décennale et propriété intellectuelle."
  filAriane={filAriane}
>
  <section class="bg-surface border-line pt-header border-b">
    <div class="wrap py-16">
      <Breadcrumbs elements={filAriane} />
      <h1 class="font-display text-h1 mt-6">Mentions légales</h1>
    </div>
  </section>

  <section class="section-y">
    <div class="wrap">
      <TexteLegal>
        <h2>Éditeur du site</h2>
        <dl>
          <dt>Dénomination sociale</dt>
          <dd>{nom}</dd>

          <dt>Forme juridique</dt>
          <dd>
            {r.formeJuridique ?? <ACompleter quoi="forme juridique (SARL, SAS, entreprise individuelle…)" />}
          </dd>

          <dt>Capital social</dt>
          <dd>
            {r.capitalSocial ?? <ACompleter quoi="montant du capital social, ou mention « sans objet »" />}
          </dd>

          <dt>Siège social</dt>
          <dd>{rue}, {codePostal} {ville}, France</dd>

          <dt>SIRET</dt>
          <dd>{r.siret ?? <ACompleter quoi="numéro SIRET à 14 chiffres" />}</dd>

          <dt>RCS</dt>
          <dd>{r.rcs ?? <ACompleter quoi="ville d’immatriculation et numéro RCS" />}</dd>

          <dt>TVA intracommunautaire</dt>
          <dd>
            {r.tvaIntracommunautaire ?? <ACompleter quoi="numéro de TVA intracommunautaire" />}
          </dd>

          <dt>Téléphone</dt>
          <dd><a href={`tel:${r.telephoneInternational ?? ENTREPRISE.telephoneE164}`} class="link-rule">{telephone}</a></dd>

          <dt>Courriel</dt>
          <dd><a href={`mailto:${email}`} class="link-rule">{email}</a></dd>

          <dt>Directeur de la publication</dt>
          <dd>
            {r.directeurPublication ?? <ACompleter quoi="nom du directeur de la publication (en général le gérant)" />}
          </dd>
        </dl>

        <h2>Hébergeur</h2>
        <p>
          Le site est hébergé par Cloudflare, Inc., 101 Townsend Street, San Francisco,
          CA 94107, États-Unis. Téléphone : +1 888 993 5273.
        </p>

        <h2>Assurance décennale</h2>
        <p>
          Conformément à l’article L. 241-1 du code des assurances, {nom} est couverte
          par une assurance de responsabilité décennale.
        </p>
        <dl>
          <dt>Compagnie d’assurance</dt>
          <dd>{r.assuranceDecennale ?? <ACompleter quoi="nom de la compagnie d’assurance" />}</dd>

          <dt>Numéro de police</dt>
          <dd>{r.numeroPoliceDecennale ?? <ACompleter quoi="numéro du contrat d’assurance décennale" />}</dd>

          <dt>Couverture géographique</dt>
          <dd>{r.zoneCouverteDecennale ?? <ACompleter quoi="zone couverte, par exemple France métropolitaine" />}</dd>
        </dl>

        <h2>Propriété intellectuelle</h2>
        <p>
          L’ensemble des contenus de ce site — textes, photographies de chantiers,
          identité visuelle — est la propriété de {nom}, sauf mention contraire. Toute
          reproduction ou représentation, totale ou partielle, sans autorisation écrite
          préalable, est interdite.
        </p>
        <p>
          Les photographies publiées dans les réalisations le sont avec l’accord des
          clients concernés.
        </p>

        <h2>Données personnelles</h2>
        <p>
          Le traitement des données transmises par les formulaires est décrit dans notre
          <a href="/politique-de-confidentialite/" class="link-rule">politique de confidentialité</a>.
        </p>

        <h2>Signalement d’un contenu</h2>
        <p>
          Pour signaler un contenu que vous estimez illicite ou une erreur sur ce site,
          écrivez à <a href={`mailto:${email}`} class="link-rule">{email}</a>.
        </p>
      </TexteLegal>
    </div>
  </section>
</Page>
