---
/**
 * Portfolio — toutes les réalisations.
 */
import Page from '~/layouts/Page.astro';
import Breadcrumbs from '~/components/chrome/Breadcrumbs.astro';
import ProjectCard from '~/components/blocks/ProjectCard.astro';
import FiltresPortfolio from '~/components/blocks/FiltresPortfolio.astro';
import CTASection from '~/components/blocks/CTASection.astro';
import { toutesLesRealisations } from '~/lib/sanity/queries';

const projets = await toutesLesRealisations();
const filAriane = [{ libelle: 'Réalisations', href: '/realisations/' }];
---

<Page
  titre="Nos réalisations"
  description="Chantiers de rénovation livrés à Saint-Denis, à Paris et en Île-de-France : appartements, maisons, studios et locaux commerciaux, avec surface, durée et corps de métier."
  filAriane={filAriane}
>
  <section class="bg-surface border-line pt-header border-b">
    <div class="wrap py-16">
      <Breadcrumbs elements={filAriane} />
      <p class="text-overline text-accent mt-6 uppercase">Réalisations</p>
      <h1 class="font-display text-h1 mt-3 max-w-measure">
        Des chantiers livrés, pas des images de synthèse.
      </h1>
      <p class="text-ink-700 mt-6 max-w-measure text-lead">
        Chaque fiche indique la surface, la durée réelle du chantier et les corps
        de métier intervenus. Les photos sont celles des chantiers, prises avant
        et après.
      </p>
    </div>
  </section>

  <section class="section-y" aria-labelledby="titre-liste">
    <div class="wrap">
      <h2 id="titre-liste" class="sr-only">Liste des réalisations</h2>

      {projets.length > 0 && <FiltresPortfolio projets={projets} />}

      {
        projets.length > 0 ? (
          <div class="mt-12 grid gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
            {projets.map((projet) => (
              <ProjectCard projet={projet} niveauTitre={3} />
            ))}
          </div>
        ) : (
          <p class="text-ink-700 max-w-measure text-body">
            Les fiches de chantier sont en cours de préparation. En attendant,
            décrivez-nous votre projet : nous vous montrerons des réalisations
            comparables lors de la visite.
          </p>
        )
      }
    </div>
  </section>

  <CTASection
    titre="Votre chantier, le prochain sur cette page ?"
    texte="Nous venons relever les lieux et vous remettons un devis détaillé poste par poste. La visite est gratuite et sans engagement."
  />
</Page>
