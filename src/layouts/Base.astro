---
/**
 * Gabarit de base — version minimale de l'étape 1.
 *
 * Sera complété à l'étape 3 : préchargement des polices, métadonnées uniques,
 * canonique, JSON-LD, contrôle du H1 en mode dev.
 */
import '~/styles/global.css';
import Header from '~/components/chrome/Header.astro';
import { LANG } from '~/lib/site';

interface Props {
  readonly titre: string;
  readonly description: string;
  readonly surHero?: boolean;
}
const { titre, description, surHero = false } = Astro.props;
const chemin = Astro.url.pathname;
---

<!doctype html>
<html lang={LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(chemin, Astro.site).href} />
  </head>
  <body>
    <Header surHero={surHero} chemin={chemin} />
    <main id="contenu">
      <slot />
    </main>
  </body>
</html>
